# --- LLM provider ---
# SHELFPULSE_PROVIDER selects the backend: anthropic (default) | groq | google
SHELFPULSE_PROVIDER=anthropic
SHELFPULSE_MODEL=claude-haiku-4-5

# Provide the key for whichever provider you chose:
ANTHROPIC_API_KEY=your_api_key_here
# GROQ_API_KEY=
# GOOGLE_API_KEY=

# --- Access gate ---
# Password required to use the service (sent as the X-App-Password header).
APP_PASSWORD=shelfpulse

# --- CORS ---
# Comma-separated allowed origins, or "*" for any. Defaults to localhost:3000.
# ALLOWED_ORIGINS=*

# --- Arize Phoenix tracing ---
# Local dev: leave the collector unset and a local Phoenix UI launches on PHOENIX_PORT.
PHOENIX_PORT=6006
PHOENIX_DISABLED=
# Remote / Phoenix Cloud (for deployment): set these to stream traces online.
# PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com
# PHOENIX_API_KEY=your_phoenix_cloud_key
#
# Frontend (set in Vercel, not here): NEXT_PUBLIC_PHOENIX_URL = your Phoenix
# project URL, so the "view in Phoenix" links open the online UI.
